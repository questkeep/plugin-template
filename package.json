{
  "name": "my-plugin",
  "version": "0.0.0",
  "private": true,
  "description": "Questkeep plugin template: tooling for packing and releasing a plugin (no dependencies, Node 24).",
  "type": "module",
  "engines": { "node": ">=24" },
  "questkeepTemplate": "pending",
  "scripts": {
    "init": "node scripts/init.mjs",
    "changeset": "node scripts/release/changeset.mjs",
    "build": "node scripts/build.mjs",
    "pack": "node scripts/pack.mjs",
    "test": "node --test scripts/release/*.test.mjs scripts/*.test.mjs"
  }
}
